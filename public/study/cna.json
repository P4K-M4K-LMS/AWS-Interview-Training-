{
  "id": "cna",
  "code": "CNA",
  "title": "Certified Nursing Assistant",
  "description": "Nurse aide training built on the federal requirements at 42 CFR 483.152 -- the sixteen hours that must come before you ever touch a resident, then basic nursing and personal care skills, cognition, restorative services and residents' rights.",
  "trackType": "certification",
  "field": "nursing",
  "requiresAcknowledgement": true,
  "units": [
    {
      "id": "cna:1",
      "index": 1,
      "title": "Before resident contact",
      "weight": 18,
      "rangeLabel": "At least 16 hours, federally required first",
      "gate": "Demonstrate the five things federal law says you must know before you are allowed near a resident at all.",
      "objectives": [
        {
          "id": "cna:1:1",
          "unitId": "cna:1",
          "index": 1,
          "text": "Why this block exists: federal law bars resident contact until it is complete",
          "sourceHash": "0009ca2b17e3",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:2",
          "unitId": "cna:1",
          "index": 2,
          "text": "Communication and interpersonal skills with residents",
          "sourceHash": "36bbc3a74a0f",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:3",
          "unitId": "cna:1",
          "index": 3,
          "text": "Communicating with families and with the care team",
          "sourceHash": "0bd1b33ea614",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:4",
          "unitId": "cna:1",
          "index": 4,
          "text": "Infection control: hand hygiene as the single highest-value habit",
          "sourceHash": "471152927e08",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:5",
          "unitId": "cna:1",
          "index": 5,
          "text": "Standard precautions and personal protective equipment",
          "sourceHash": "05ec7e639d9c",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:6",
          "unitId": "cna:1",
          "index": 6,
          "text": "Safety and emergency procedures",
          "sourceHash": "537dbd157516",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:7",
          "unitId": "cna:1",
          "index": 7,
          "text": "The Heimlich maneuver, named explicitly in the regulation",
          "sourceHash": "bd3b44e7db46",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:8",
          "unitId": "cna:1",
          "index": 8,
          "text": "Recognising an emergency and summoning help correctly",
          "sourceHash": "501a16b5b448",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:9",
          "unitId": "cna:1",
          "index": 9,
          "text": "Promoting residents' independence rather than doing for them",
          "sourceHash": "37b02cdd650f",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:1:10",
          "unitId": "cna:1",
          "index": 10,
          "text": "Respecting residents' rights in everyday interaction",
          "sourceHash": "6b7f309fe9d3",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        }
      ]
    },
    {
      "id": "cna:2",
      "index": 2,
      "title": "Basic nursing skills",
      "weight": 18,
      "rangeLabel": "42 CFR 483.152(b)(2)",
      "gate": "Take an accurate set of measurements, notice when something has changed, and report it to the nurse without editorialising.",
      "objectives": [
        {
          "id": "cna:2:1",
          "unitId": "cna:2",
          "index": 1,
          "text": "Taking and recording temperature, pulse, respiration and blood pressure",
          "sourceHash": "0dec030344b3",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:2",
          "unitId": "cna:2",
          "index": 2,
          "text": "Recognising a measurement that falls outside the expected range",
          "sourceHash": "6eacf9c6510c",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:3",
          "unitId": "cna:2",
          "index": 3,
          "text": "Measuring and recording height and weight",
          "sourceHash": "5fd271321cdd",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:4",
          "unitId": "cna:2",
          "index": 4,
          "text": "Caring for the resident's environment: bed, unit, call light within reach",
          "sourceHash": "6ebfa44c032f",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:5",
          "unitId": "cna:2",
          "index": 5,
          "text": "Bed making, occupied and unoccupied",
          "sourceHash": "afaced8d2f62",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:6",
          "unitId": "cna:2",
          "index": 6,
          "text": "Recognising abnormal changes in body functioning",
          "sourceHash": "e699e78d8167",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:7",
          "unitId": "cna:2",
          "index": 7,
          "text": "Reporting changes to the nurse: what, when and in what words",
          "sourceHash": "e9ed5d21af16",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:8",
          "unitId": "cna:2",
          "index": 8,
          "text": "Observation versus interpretation, and why the aide reports the first",
          "sourceHash": "a17a3b9fe876",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:9",
          "unitId": "cna:2",
          "index": 9,
          "text": "Caring for residents when death is imminent",
          "sourceHash": "2dd7bd9ae1d3",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:10",
          "unitId": "cna:2",
          "index": 10,
          "text": "Supporting the family of a dying resident",
          "sourceHash": "39bd26610d2a",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "cna:2:11",
          "unitId": "cna:2",
          "index": 11,
          "text": "Documenting care accurately and within scope",
          "sourceHash": "15409621e334",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        }
      ]
    },
