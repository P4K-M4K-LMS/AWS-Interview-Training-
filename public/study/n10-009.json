          "unitId": "n10-009:1",
          "index": 8,
          "text": "Network topologies: mesh, star, spine-and-leaf, and three-tier designs",
          "sourceHash": "a0fc53a3a6b5",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "n10-009:1:9",
          "unitId": "n10-009:1",
          "index": 9,
          "text": "IPv4 addressing: public vs. private ranges, subnetting, and address classes",
          "sourceHash": "a0cdf3ed50e6",
          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        }
      ]
    },
    {
