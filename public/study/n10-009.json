{
  "id": "n10-009",
  "code": "NETWORKPLUS",
  "title": "Network+",
  "description": "CompTIA Network+ (N10-009) exam prep across 5 weighted domains -- networking concepts, implementation, operations, security, and troubleshooting.",
  "trackType": "certification",
