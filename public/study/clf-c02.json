          "kind": "objective",
          "modality": "read",
          "modalitySource": "default"
        },
        {
          "id": "clf-c02:1:8",
          "unitId": "clf-c02:1",
          "index": 8,
          "text": "Migration strategies and which one fits a given workload, including database replication",
